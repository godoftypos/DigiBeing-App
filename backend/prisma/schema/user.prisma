model User {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    // Personal Details
    profile_photo     String?
    name              String
    email             String
    phone             String?
    dateOfBirth       DateTime?
    gender            String?
    riskScore         Float     @default(0)
    detectedAppsCount Int       @default(0)

    // Gamification Stats
    level             Int @default(1)
    currentXp         Int @default(0)
    xpToNextLevel     Int @default(100)
    missionsCompleted Int @default(0)
    focusDays         Int @default(0)
    maxStreak         Int @default(1)
    currentStreak     Int @default(1)
    lastStreakUpdatedAt DateTime? // Track when streak was last updated

    // metadata
    onboardingDone   Boolean   @default(false)
    is_active        Boolean   @default(false)
    access_token     String?
    last_login       DateTime?
    generated_otp    Int?
    otp_generated_at DateTime?

    // Relations
    usageData             UsageData[]
    missions              UserMission[]
    badges                UserBadge[]
    completedAchievements CompletedAchievement[]

    // time stamps
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@map("users")
}

model UsageData {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    userId      String   @db.ObjectId
    user        User     @relation(fields: [userId], references: [id])
    appName     String
    packageName String
    usage       Int // Stored in milliseconds (from Android UsageStats)
    timeRange   String // "today", "week", "month"
    date        DateTime // The specific date this usage is for
    timestamp   DateTime @default(now()) // When this record was created/updated

    @@index([userId, timeRange, date])
    @@index([userId, packageName, timeRange])
    @@map("usage_data")
}
